{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot strip plot: birth rate by state across selected years",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/birth_state.csv"
  },
  "transform": [
    {
      "calculate": "year(datum.date)",
      "as": "year"
    },
    {
      "filter": "datum.year % 3 == 0"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/state_snapshot.csv"
        },
        "key": "state",
        "fields": [
          "income_group"
        ]
      }
    },
    {
      "filter": "datum.income_group != null"
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "size": 90,
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelFont": "JetBrains Mono",
        "labelFontSize": 11,
        "labelColor": "#8b949e",
        "grid": false
      }
    },
    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": "Birth Rate (per 1,000)",
      "scale": {
        "zero": false
      },
      "axis": {
        "gridColor": "#30363d"
      }
    },
    "color": {
      "field": "income_group",
      "type": "nominal",
      "title": "Income Group",
      "scale": {
        "domain": [
          "Low (<5.5k)",
          "Middle (5.5-8k)",
          "High (>8k)"
        ],
        "range": [
          "#E69F00",
          "#56B4E9",
          "#0072B2"
        ]
      },
      "legend": {
        "orient": "top",
        "title": "Income Group",
        "labelFont": "JetBrains Mono",
        "labelFontSize": 11
      }
    },
    "shape": {
      "field": "income_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Low (<5.5k)",
          "Middle (5.5-8k)",
          "High (>8k)"
        ],
        "range": [
          "triangle-up",
          "circle",
          "square"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "rate",
        "title": "Birth Rate (per 1,000)",
        "format": ".1f"
      },
      {
        "field": "income_group",
        "title": "Income Group"
      }
    ]
  }
}