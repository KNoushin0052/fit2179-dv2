{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Gapminder-style animated bubble chart: household income vs birth rate over time",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/birth_state.csv"
  },
  "params": [
    {
      "name": "year_select",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.state != 'W.P. Putrajaya'"
    },
    {
      "calculate": "year(datum.date)",
      "as": "year"
    },
    {
      "filter": "datum.year == year_select"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/state_snapshot.csv"
        },
        "key": "state",
        "fields": [
          "income_mean",
          "poverty",
          "income_group"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 90,
        "font": "Source Serif 4",
        "fontWeight": "bold",
        "color": "var(--border)",
        "opacity": 0.35
      },
      "encoding": {
        "x": {
          "datum": 13000,
          "type": "quantitative"
        },
        "y": {
          "datum": 28,
          "type": "quantitative"
        },
        "text": {
          "expr": "year_select"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "var(--border)",
        "strokeDash": [
          4,
          3
        ]
      },
      "transform": [
        {
          "regression": "rate",
          "on": "income_mean"
        }
      ],
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative"
        },
        "y": {
          "field": "rate",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0.85,
        "stroke": "var(--border)",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "scale": {
            "domain": [
              4000,
              14000
            ]
          },
          "axis": {
            "format": ","
          }
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "title": "Birth Rate (per 1,000 population)",
          "scale": {
            "domain": [
              8,
              32
            ]
          }
        },
        "size": {
          "field": "poverty",
          "type": "quantitative",
          "title": "Poverty Rate (%)",
          "scale": {
            "range": [
              60,
              650
            ]
          },
          "legend": {
            "orient": "right",
            "titleFont": "JetBrains Mono",
            "titleFontSize": 10,
            "labelFont": "JetBrains Mono",
            "labelFontSize": 10
          }
        },
        "color": {
          "field": "income_group",
          "type": "nominal",
          "title": "Income Group",
          "scale": {
            "domain": [
              "Low (<5.5k)",
              "Middle (5.5–8k)",
              "High (>8k)"
            ],
            "range": [
              "var(--red)",
              "var(--accent)",
              "var(--blue)"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFont": "JetBrains Mono",
            "titleFontSize": 10,
            "labelFont": "JetBrains Mono",
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "rate",
            "title": "Birth Rate",
            "format": ".1f"
          },
          {
            "field": "income_mean",
            "title": "Mean Income (RM)",
            "format": ","
          },
          {
            "field": "poverty",
            "title": "Poverty Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -13,
        "fontSize": 9,
        "font": "JetBrains Mono",
        "color": "var(--muted)"
      },
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative"
        },
        "y": {
          "field": "rate",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      },
      "transform": [
        {
          "filter": "indexof(['Kelantan','Terengganu','W.P. Kuala Lumpur','Selangor','Pulau Pinang','Sabah','Kedah'], datum.state) >= 0"
        }
      ]
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 10,
        "font": "JetBrains Mono",
        "fontStyle": "italic",
        "color": "var(--muted)"
      },
      "encoding": {
        "x": {
          "datum": 13500,
          "type": "quantitative"
        },
        "y": {
          "datum": 10.5,
          "type": "quantitative"
        },
        "text": {
          "value": "Richer states \u2192 fewer babies"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "font": "JetBrains Mono",
        "fontStyle": "italic",
        "color": "var(--muted)"
      },
      "encoding": {
        "x": {
          "datum": 4200,
          "type": "quantitative"
        },
        "y": {
          "datum": 25.5,
          "type": "quantitative"
        },
        "text": {
          "value": "\u2190 Poorer states: higher birth rates"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "var(--muted)",
        "strokeWidth": 1.2,
        "strokeDash": [4, 4],
        "opacity": 0.6
      },
      "encoding": {
        "y": {
          "datum": 14.0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -6,
        "fontSize": 9.5,
        "font": "JetBrains Mono",
        "color": "var(--muted)"
      },
      "encoding": {
        "x": {
          "value": 10
        },
        "y": {
          "datum": 14.0,
          "type": "quantitative"
        },
        "text": {
          "value": "Replacement Level Birth Rate (~14.0)"
        }
      }
    }
  ]
}