{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Parallel coordinates plot: socioeconomic profiles of 5 key states",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/state_snapshot.csv"
  },
  "transform": [
    {
      "filter": "datum.state == 'W.P. Kuala Lumpur' || datum.state == 'Selangor' || datum.state == 'Kelantan' || datum.state == 'Terengganu' || datum.state == 'Sabah'"
    },
    {
      "fold": [
        "rate_2000",
        "birth_rate",
        "poverty",
        "gini",
        "income_mean"
      ],
      "as": [
        "metric",
        "raw_value"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "raw_value",
          "as": "min_v"
        },
        {
          "op": "max",
          "field": "raw_value",
          "as": "max_v"
        }
      ],
      "groupby": [
        "metric"
      ]
    },
    {
      "calculate": "(datum.raw_value - datum.min_v) / (datum.max_v - datum.min_v)",
      "as": "norm_value"
    },
    {
      "calculate": "datum.metric == 'rate_2000' ? 'Birth Rate (2000)' : datum.metric == 'birth_rate' ? 'Birth Rate (2023)' : datum.metric == 'poverty' ? 'Poverty Rate (%)' : datum.metric == 'gini' ? 'Gini Coefficient' : 'Mean Income (RM)'",
      "as": "MetricLabel"
    },
    {
      "calculate": "datum.metric == 'rate_2000' ? 1 : datum.metric == 'birth_rate' ? 2 : datum.metric == 'poverty' ? 3 : datum.metric == 'gini' ? 4 : 5",
      "as": "MetricOrder"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "MetricLabel",
          "type": "nominal",
          "sort": {
            "field": "MetricOrder",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "labelAngle": -15
          }
        },
        "y": {
          "field": "norm_value",
          "type": "quantitative",
          "title": "Normalized Socioeconomic Value (0-1)",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "W.P. Kuala Lumpur",
              "Selangor",
              "Kelantan",
              "Terengganu",
              "Sabah"
            ],
            "range": [
              "var(--blue)",
              "var(--accent)",
              "var(--green)",
              "var(--purple)",
              "var(--muted)"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "columns": 3
          }
        },
        "detail": {
          "field": "state"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "stroke": "var(--surface)",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "MetricLabel",
          "type": "nominal",
          "sort": {
            "field": "MetricOrder",
            "order": "ascending"
          }
        },
        "y": {
          "field": "norm_value",
          "type": "quantitative"
        },
        "color": {
          "field": "state",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "MetricLabel",
            "title": "Metric"
          },
          {
            "field": "raw_value",
            "title": "Actual Value",
            "format": ","
          }
        ]
      }
    }
  ]
}