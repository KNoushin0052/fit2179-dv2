{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Radar/Spider chart: multi-metric state comparison — KL, Selangor, Kelantan, Terengganu, Sabah",
  "width": 340,
  "height": 340,
  "data": {
    "url": "data/state_snapshot.csv"
  },
  "transform": [
    {
      "filter": "datum.state == 'W.P. Kuala Lumpur' || datum.state == 'Selangor' || datum.state == 'Kelantan' || datum.state == 'Terengganu' || datum.state == 'Sabah'"
    },
    {
      "calculate": "datum.birth_rate",
      "as": "birth_rate_dup"
    },
    {
      "fold": [
        "birth_rate",
        "rate_2000",
        "poverty",
        "income_mean",
        "gini",
        "birth_rate_dup"
      ],
      "as": [
        "metric",
        "raw_value"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "raw_value",
          "as": "min_v"
        },
        {
          "op": "max",
          "field": "raw_value",
          "as": "max_v"
        }
      ],
      "groupby": [
        "metric"
      ]
    },
    {
      "calculate": "(datum.raw_value - datum.min_v) / (datum.max_v - datum.min_v)",
      "as": "norm_value"
    },
    {
      "calculate": "datum.metric == 'birth_rate' ? 0 : datum.metric == 'rate_2000' ? 1.2566 : datum.metric == 'poverty' ? 2.5133 : datum.metric == 'income_mean' ? 3.7699 : datum.metric == 'gini' ? 5.0265 : 6.2832",
      "as": "angle"
    },
    {
      "calculate": "datum.norm_value * cos(datum.angle)",
      "as": "x"
    },
    {
      "calculate": "datum.norm_value * sin(datum.angle)",
      "as": "y"
    },
    {
      "calculate": "datum.metric == 'birth_rate' ? 'Birth Rate 2023' : datum.metric == 'rate_2000' ? 'Birth Rate 2000' : datum.metric == 'poverty' ? 'Poverty Rate (%)' : datum.metric == 'income_mean' ? 'Mean Income (RM)' : datum.metric == 'gini' ? 'Gini Coefficient' : 'Birth Rate 2023 (dup)'",
      "as": "MetricName"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {"r": 0.25},
          {"r": 0.5},
          {"r": 0.75},
          {"r": 1.0}
        ]
      },
      "mark": {
        "type": "arc",
        "filled": false,
        "stroke": "var(--border)",
        "strokeWidth": 0.5,
        "opacity": 0.5
      },
      "encoding": {
        "theta": {"datum": 0},
        "theta2": {"datum": 6.2832},
        "radius": {
          "field": "r",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {"angle": 0},
          {"angle": 1.2566},
          {"angle": 2.5133},
          {"angle": 3.7699},
          {"angle": 5.0265}
        ]
      },
      "transform": [
        {"calculate": "cos(datum.angle)", "as": "x2"},
        {"calculate": "sin(datum.angle)", "as": "y2"}
      ],
      "mark": {
        "type": "rule",
        "color": "var(--border)",
        "strokeWidth": 0.5,
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "x2": {
          "field": "x2",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {"metric": "Birth Rate 2023", "angle": 0},
          {"metric": "Birth Rate 2000", "angle": 1.2566},
          {"metric": "Poverty Rate", "angle": 2.5133},
          {"metric": "Mean Income", "angle": 3.7699},
          {"metric": "Gini Coefficient", "angle": 5.0265}
        ]
      },
      "transform": [
        {"calculate": "1.15 * cos(datum.angle)", "as": "lx"},
        {"calculate": "1.15 * sin(datum.angle)", "as": "ly"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "font": "JetBrains Mono",
        "color": "var(--muted)"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "y": {
          "field": "ly",
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "text": {
          "field": "metric"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.75,
        "filled": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "W.P. Kuala Lumpur",
              "Selangor",
              "Kelantan",
              "Terengganu",
              "Sabah"
            ],
            "range": [
              "var(--blue)",
              "var(--accent)",
              "var(--green)",
              "var(--red)",
              "var(--muted)"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "title": null
          }
        },
        "detail": {
          "field": "state"
        },
        "order": {
          "field": "angle",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.metric != 'birth_rate_dup'"}
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {"domain": [-1.4, 1.4]}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "W.P. Kuala Lumpur",
              "Selangor",
              "Kelantan",
              "Terengganu",
              "Sabah"
            ],
            "range": [
              "var(--blue)",
              "var(--accent)",
              "var(--green)",
              "var(--red)",
              "var(--muted)"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "MetricName", "title": "Metric"},
          {"field": "raw_value", "title": "Value", "format": ","}
        ]
      }
    }
  ]
}