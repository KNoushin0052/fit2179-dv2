{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Stream graph: national births by ethnicity 2000-2023 with direct labels",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/birth_sex_ethnic_state.csv"
  },
  "transform": [
    {
      "calculate": "year(datum.date)",
      "as": "year"
    },
    {
      "filter": "datum.sex == 'both' && (datum.ethnicity == 'bumi_malay' || datum.ethnicity == 'chinese' || datum.ethnicity == 'indian' || datum.ethnicity == 'bumi_other')"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "abs",
          "as": "births"
        }
      ],
      "groupby": [
        "year",
        "ethnicity"
      ]
    },
    {
      "calculate": "datum.ethnicity == 'bumi_malay' ? 'Bumiputera Malay' : datum.ethnicity == 'chinese' ? 'Chinese' : datum.ethnicity == 'indian' ? 'Indian' : 'Other Bumiputera'",
      "as": "group"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "axis": {
        "format": "d",
        "title": null
      }
    },
    "y": {
      "field": "births",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Bumiputera Malay",
          "Other Bumiputera",
          "Chinese",
          "Indian"
        ],
        "range": [
          "var(--blue)",
          "var(--muted)",
          "var(--accent)",
          "var(--green)"
        ]
      },
      "legend": {
        "orient": "top",
        "columns": 4,
        "title": null,
        "labelFont": "JetBrains Mono",
        "labelFontSize": 11
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "ethnicity_select",
          "select": {
            "type": "point",
            "fields": [
              "group"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.85
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "ethnicity_select",
            "value": 0.9
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "group",
            "title": "Ethnicity"
          },
          {
            "field": "births",
            "title": "Births",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2023"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 9.5,
        "font": "JetBrains Mono",
        "fontWeight": "bold"
      },
      "encoding": {
        "detail": {
          "field": "group"
        },
        "text": {
          "field": "group"
        }
      }
    }
  ]
}