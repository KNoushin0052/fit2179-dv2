{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Faceted donut charts: ethnic composition of births by state, 2023",
  "data": {
    "url": "data/birth_sex_ethnic_state.csv"
  },
  "transform": [
    {
      "calculate": "year(datum.date)",
      "as": "year"
    },
    {
      "filter": "datum.year == 2023 && datum.sex == 'both'"
    },
    {
      "filter": "datum.ethnicity == 'bumi_malay' || datum.ethnicity == 'chinese' || datum.ethnicity == 'indian' || datum.ethnicity == 'bumi_other'"
    },
    {
      "calculate": "datum.ethnicity == 'bumi_malay' ? 'Malay' : datum.ethnicity == 'chinese' ? 'Chinese' : datum.ethnicity == 'indian' ? 'Indian' : 'Other'",
      "as": "group"
    },
    {
      "filter": "datum.state != 'W.P. Labuan' && datum.state != 'W.P. Putrajaya'"
    }
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "header": {
      "labelFontSize": 11,
      "labelFont": "JetBrains Mono",
      "title": null,
      "labelPadding": 6
    }
  },
  "columns": 7,
  "spacing": 15,
  "spec": {
    "width": 110,
    "height": 110,
    "layer": [
      {
        "mark": {
          "type": "arc",
          "innerRadius": 30,
          "outerRadius": 50,
          "stroke": null
        },
        "encoding": {
          "theta": {
            "field": "abs",
            "type": "quantitative",
            "stack": true
          },
          "color": {
            "field": "group",
            "type": "nominal",
            "scale": {
              "domain": [
                "Malay",
                "Chinese",
                "Indian",
                "Other"
              ],
              "range": [
                "var(--blue)",
                "var(--accent)",
                "var(--green)",
                "var(--muted)"
              ]
            },
            "legend": {
              "orient": "top",
              "columns": 4,
              "title": null,
              "labelFont": "JetBrains Mono",
              "labelFontSize": 11
            }
          },
          "tooltip": [
            {
              "field": "state",
              "title": "State"
            },
            {
              "field": "group",
              "title": "Ethnicity"
            },
            {
              "field": "abs",
              "title": "Births",
              "format": ","
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "radius": 0,
          "fontSize": 10,
          "font": "JetBrains Mono",
          "fontWeight": "bold",
          "fill": "var(--muted)"
        },
        "encoding": {
          "text": {
            "aggregate": "sum",
            "field": "abs",
            "format": ".2s"
          }
        }
      }
    ]
  }
}