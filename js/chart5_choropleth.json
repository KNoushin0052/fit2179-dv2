{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Malaysia with interactive year slider",
  "width": "container",
  "height": 440,
  "params": [
    {
      "name": "year_select",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/datamaps@0.5.10/src/js/data/mys.topo.json",
        "format": {
          "type": "topojson",
          "feature": "mys"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "var(--surface-2)",
        "stroke": "var(--border)",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/birth_state.csv"
      },
      "transform": [
        {
          "calculate": "year(datum.date)",
          "as": "year"
        },
        {
          "filter": "datum.year == year_select"
        },
        {
          "calculate": "datum.state == 'W.P. Kuala Lumpur' ? 'Kuala Lumpur' : datum.state == 'W.P. Labuan' ? 'Labuan' : datum.state == 'W.P. Putrajaya' ? 'Putrajaya' : datum.state == 'Terengganu' ? 'Trengganu' : datum.state",
          "as": "topo_state_name"
        },
        {
          "lookup": "topo_state_name",
          "from": {
            "data": {
              "url": "https://cdn.jsdelivr.net/npm/datamaps@0.5.10/src/js/data/mys.topo.json",
              "format": {
                "type": "topojson",
                "feature": "mys"
              }
            },
            "key": "properties.name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "var(--border)",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "Birth Rate (‰)",
          "scale": {
            "domain": [
              10,
              30
            ],
            "range": [
              "var(--surface-2)",
              "var(--blue)"
            ]
          },
          "legend": {
            "orient": "top-right",
            "direction": "vertical",
            "gradientLength": 140,
            "titleFont": "JetBrains Mono",
            "titleFontSize": 10,
            "labelFont": "JetBrains Mono",
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "rate",
            "title": "Birth Rate (per 1,000)",
            "format": ".1f"
          },
          {
            "field": "abs",
            "title": "Total Births",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 99.6,
            "lat": 2.7,
            "label": "KL & Selangor: lowest \u2192"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "font": "JetBrains Mono",
        "fontWeight": "bold",
        "color": "var(--muted)",
        "align": "right"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 104.9,
            "lat": 5.4,
            "label": "\u2190 East coast: highest"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "font": "JetBrains Mono",
        "fontWeight": "bold",
        "color": "var(--muted)",
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}