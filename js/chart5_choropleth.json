{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Malaysia: birth rate by state 2023",
  "width": "container",
  "height": 420,
  "projection": { "type": "mercator" },
  "data": {
    "url": "data/malaysia-states.geojson",
    "format": { "type": "json", "property": "features" }
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": { "url": "data/birth_state.csv" },
        "transform": [
          { "calculate": "year(datum.date)", "as": "year" },
          { "filter": "datum.year == 2023" }
        ],
        "key": "state",
        "fields": ["rate", "abs"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#30363d",
    "strokeWidth": 0.8
  },
  "encoding": {
    "color": {
      "field": "rate",
      "type": "quantitative",
      "title": "Birth Rate (per 1,000)",
      "scale": {
        "domain": [10, 22],
        "scheme": "orangered"
      },
      "legend": {
        "orient": "right",
        "gradientLength": 200
      }
    },
    "tooltip": [
      { "field": "properties.name", "title": "State" },
      { "field": "rate", "title": "Birth Rate (per 1,000)", "format": ".1f" },
      { "field": "abs", "title": "Total Births", "format": "," }
    ]
  }
}
