{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Malaysia with interactive year slider",
  "width": "container",
  "height": 440,
  "params": [
    {
      "name": "year_select",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/datamaps@0.5.10/src/js/data/mys.topo.json",
        "format": {
          "type": "topojson",
          "feature": "mys"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "var(--surface-2)",
        "stroke": "var(--border)",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/birth_state.csv"
      },
      "transform": [
        {
          "calculate": "year(datum.date)",
          "as": "year"
        },
        {
          "filter": "datum.year == year_select"
        },
        {
          "calculate": "datum.state == 'W.P. Kuala Lumpur' ? 'Kuala Lumpur' : datum.state == 'W.P. Labuan' ? 'Labuan' : datum.state == 'W.P. Putrajaya' ? 'Putrajaya' : datum.state == 'Terengganu' ? 'Trengganu' : datum.state",
          "as": "topo_state_name"
        },
        {
          "lookup": "topo_state_name",
          "from": {
            "data": {
              "url": "https://cdn.jsdelivr.net/npm/datamaps@0.5.10/src/js/data/mys.topo.json",
              "format": {
                "type": "topojson",
                "feature": "mys"
              }
            },
            "key": "properties.name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "var(--border)",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "Birth Rate (‰)",
          "scale": {
            "domain": [
              10,
              30
            ],
            "range": [
              "var(--surface-2)",
              "var(--blue)"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleFont": "JetBrains Mono",
            "titleFontSize": 10,
            "labelFont": "JetBrains Mono",
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "rate",
            "title": "Birth Rate (per 1,000)",
            "format": ".1f"
          },
          {
            "field": "abs",
            "title": "Total Births",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "Kedah", "lon": 100.5, "lat": 6.0, "align": "center"},
          {"state": "Perak", "lon": 101.0, "lat": 4.8, "align": "center"},
          {"state": "Pahang", "lon": 102.5, "lat": 3.7, "align": "center"},
          {"state": "Johor", "lon": 103.0, "lat": 1.9, "align": "center"},
          {"state": "Sarawak", "lon": 113.3, "lat": 2.6, "align": "center"},
          {"state": "Sabah", "lon": 116.8, "lat": 5.8, "align": "center"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9,
        "font": "JetBrains Mono",
        "fontWeight": "bold",
        "color": "var(--muted)",
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "align": {
          "field": "align",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon1": 106.0,
            "lat1": 5.8,
            "lon2": 103.1,
            "lat2": 5.0,
            "text": "Highest: Terengganu (21.6‰)",
            "align": "left"
          },
          {
            "lon1": 98.0,
            "lat1": 2.8,
            "lon2": 101.69,
            "lat2": 3.14,
            "text": "Lowest: Kuala Lumpur (10.7‰)",
            "align": "right"
          },
          {
            "lon1": 98.0,
            "lat1": 4.6,
            "lon2": 101.0,
            "lat2": 4.6,
            "text": "Steepest drop: Perak (-11.1‰)",
            "align": "right"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "var(--muted)",
            "strokeWidth": 0.8,
            "strokeDash": [
              3,
              3
            ],
            "opacity": 0.7
          },
          "encoding": {
            "longitude": {
              "field": "lon1",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat1",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2",
              "type": "quantitative"
            },
            "latitude2": {
              "field": "lat2",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 9.5,
            "font": "JetBrains Mono",
            "color": "var(--text)",
            "fontWeight": "bold",
            "align": {"expr": "datum.align"},
            "dy": -5
          },
          "encoding": {
            "longitude": {
              "field": "lon1",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat1",
              "type": "quantitative"
            },
            "text": {
              "field": "text",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 108.0,
            "lat": 6.3,
            "text": [
              "MALAYSIA'S DEMOGRAPHIC DIVIDE",
              "• Urban Wealth = Birth Drought: Developed states",
              "  on the West Coast (KL, Selangor, Penang) have",
              "  collapsed far below the 2.1 replacement rate.",
              "• Rural Poverty = Higher Births: Less developed",
              "  states (Terengganu, Kelantan) maintain higher",
              "  birth rates, but face a steady decline.",
              "• Drag the slider below to travel through time."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 9,
        "font": "JetBrains Mono",
        "color": "var(--text)",
        "opacity": 0.85,
        "lineHeight": 14
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    }
  ]
}