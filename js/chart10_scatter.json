{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop: monthly money left after spending (income - expenditure) by state, coloured by birth rate",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/state_snapshot.csv",
    "format": {"type": "csv", "parse": {"income_mean": "number", "expenditure_mean": "number", "birth_rate": "number"}}
  },
  "transform": [
    {"filter": "datum.state != 'W.P. Putrajaya'"},
    {"calculate": "datum.income_mean - datum.expenditure_mean", "as": "disposable"}
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {"field": "disposable", "order": "descending"},
      "title": null,
      "axis": {"labelFontSize": 11}
    },
    "x": {
      "field": "disposable",
      "type": "quantitative",
      "title": "Money left after spending (RM/month)",
      "scale": {"domain": [0, 6000]},
      "axis": {"format": ","}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2, "color": "var(--border)"},
      "encoding": {"x": {"datum": 0}, "x2": {"field": "disposable"}}
    },
    {
      "mark": {"type": "point", "filled": true, "size": 200, "stroke": "var(--surface)", "strokeWidth": 1.2},
      "encoding": {
        "color": {
          "field": "birth_rate",
          "type": "quantitative",
          "title": "Birth rate (per 1,000)",
          "scale": {"domain": [10, 14, 22], "range": ["var(--accent)", "var(--muted)", "var(--blue)"]},
          "legend": {"orient": "top", "titleFont": "JetBrains Mono", "labelFont": "JetBrains Mono", "gradientLength": 160}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "disposable", "title": "Money left over (RM)", "format": ","},
          {"field": "income_mean", "title": "Income (RM)", "format": ","},
          {"field": "expenditure_mean", "title": "Spending (RM)", "format": ","},
          {"field": "birth_rate", "title": "Birth rate", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 9, "font": "JetBrains Mono", "color": "var(--muted)"},
      "transform": [{"filter": "datum.state == 'W.P. Kuala Lumpur'"}],
      "encoding": {"x": {"field": "disposable"}, "text": {"value": "← most left over, fewest babies"}}
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 9, "font": "JetBrains Mono", "color": "var(--muted)"},
      "transform": [{"filter": "datum.state == 'Kelantan'"}],
      "encoding": {"x": {"field": "disposable"}, "text": {"value": "← least left over, yet plenty of babies"}}
    }
  ]
}
