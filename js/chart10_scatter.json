{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped bar chart: household income vs expenditure by state 2022",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/state_snapshot.csv"
  },
  "transform": [
    {
      "filter": "datum.state != 'W.P. Putrajaya'"
    },
    {
      "fold": [
        "income_mean",
        "expenditure_mean"
      ],
      "as": [
        "metric",
        "value"
      ]
    },
    {
      "calculate": "datum.metric == 'income_mean' ? 'Mean Household Income' : 'Mean Household Expenditure'",
      "as": "MetricLabel"
    }
  ],
  "mark": {
    "type": "bar",
    "height": 11,
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {
        "field": "value",
        "op": "max",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelFontSize": 11,
        "labelFont": "JetBrains Mono",
        "minExtent": 115
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Amount (RM/month)",
      "axis": {
        "format": ","
      }
    },
    "yOffset": {
      "field": "MetricLabel",
      "type": "nominal"
    },
    "color": {
      "field": "MetricLabel",
      "type": "nominal",
      "scale": {
        "domain": [
          "Mean Household Income",
          "Mean Household Expenditure"
        ],
        "range": [
          "var(--blue)",
          "var(--accent)"
        ]
      },
      "legend": {
        "orient": "bottom",
        "title": null,
        "labelFont": "JetBrains Mono",
        "labelFontSize": 10
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "MetricLabel",
        "title": "Metric"
      },
      {
        "field": "value",
        "title": "Value (RM)",
        "format": ","
      }
    ]
  }
}