{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart: birth rate 2000 vs 2023 by state",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/state_snapshot.csv"
  },
  "transform": [
    {
      "filter": "datum.state != 'W.P. Putrajaya'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "var(--border)",
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "birth_rate",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "minExtent": 115
          }
        },
        "x": {
          "field": "rate_2000",
          "type": "quantitative",
          "title": "Birth Rate (per 1,000)",
          "scale": {
            "zero": false
          }
        },
        "x2": {
          "field": "birth_rate"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "birth_rate",
            "order": "descending"
          }
        },
        "x": {
          "field": "rate_2000",
          "type": "quantitative"
        },
        "color": {
          "datum": "2000",
          "type": "nominal",
          "scale": {
            "domain": [
              "2000",
              "2023"
            ],
            "range": [
              "var(--blue)",
              "var(--accent)"
            ]
          },
          "legend": {
            "orient": "top",
            "title": "Year",
            "labelFont": "JetBrains Mono",
            "titleFont": "JetBrains Mono"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "rate_2000",
            "title": "Birth Rate 2000",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "birth_rate",
            "order": "descending"
          }
        },
        "x": {
          "field": "birth_rate",
          "type": "quantitative"
        },
        "color": {
          "datum": "2023",
          "type": "nominal",
          "scale": {
            "domain": [
              "2000",
              "2023"
            ],
            "range": [
              "var(--blue)",
              "var(--accent)"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "rate_2000",
            "title": "Birth Rate 2000",
            "format": ".1f"
          },
          {
            "field": "birth_rate",
            "title": "Birth Rate 2023",
            "format": ".1f"
          },
          {
            "field": "rate_change",
            "title": "Change",
            "format": "+.1f"
          },
          {
            "field": "income_mean",
            "title": "Mean Income (RM)",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Perak'"
        },
        {
          "calculate": "(datum.rate_2000 + datum.birth_rate)/2",
          "as": "mid"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -9,
        "fontSize": 9,
        "font": "JetBrains Mono",
        "color": "var(--muted)"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "birth_rate",
            "order": "descending"
          }
        },
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "value": "Steepest fall  \u221211.1 \u2193"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Terengganu'"
        },
        {
          "calculate": "(datum.rate_2000 + datum.birth_rate)/2",
          "as": "mid"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -9,
        "fontSize": 9,
        "font": "JetBrains Mono",
        "color": "var(--muted)"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "birth_rate",
            "order": "descending"
          }
        },
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "value": "Smallest fall  \u22125.9"
        }
      }
    }
  ]
}