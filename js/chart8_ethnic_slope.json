{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "100% stacked bar: ethnic share of national births, 2000 vs 2023",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/birth_sex_ethnic_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "abs": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "year(datum.date)",
      "as": "year"
    },
    {
      "filter": "datum.sex == 'both' && (datum.year == 2000 || datum.year == 2023)"
    },
    {
      "filter": "datum.ethnicity == 'bumi_malay' || datum.ethnicity == 'chinese' || datum.ethnicity == 'indian' || datum.ethnicity == 'bumi_other'"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "abs",
          "as": "births"
        }
      ],
      "groupby": [
        "year",
        "ethnicity"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "births",
          "as": "year_total"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "calculate": "datum.births / datum.year_total",
      "as": "share"
    },
    {
      "calculate": "datum.ethnicity == 'bumi_malay' ? 'Bumiputera Malay' : datum.ethnicity == 'chinese' ? 'Chinese' : datum.ethnicity == 'indian' ? 'Indian' : 'Other Bumiputera'",
      "as": "group"
    },
    {
      "stack": "share",
      "groupby": ["year"],
      "sort": [{"field": "group", "order": "ascending"}],
      "as": ["lower", "upper"]
    },
    {
      "calculate": "(datum.lower + datum.upper) / 2",
      "as": "midpoint"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of national births",
      "axis": {
        "format": "%"
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Ethnicity",
      "scale": {
        "domain": [
          "Bumiputera Malay",
          "Other Bumiputera",
          "Chinese",
          "Indian"
        ],
        "range": [
          "var(--blue)",
          "var(--muted)",
          "var(--accent)",
          "var(--green)"
        ]
      },
      "legend": {
        "orient": "top",
        "columns": 2,
        "titleFont": "JetBrains Mono",
        "labelFont": "JetBrains Mono",
        "labelFontSize": 11
      }
    },
    "order": {
      "field": "group"
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "group",
        "title": "Ethnicity"
      },
      {
        "field": "share",
        "title": "Share",
        "format": ".1%"
      },
      {
        "field": "births",
        "title": "Births",
        "format": ","
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": {
          "band": 0.6
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "font": "JetBrains Mono",
        "fontWeight": "bold",
        "color": "white",
        "stroke": "#1a1611",
        "strokeWidth": 0.4,
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0%"
        },
        "detail": {
          "field": "group"
        },
        "y": {
          "field": "midpoint",
          "type": "quantitative",
          "stack": null
        },
        "color": {
          "value": "white"
        }
      }
    }
  ]
}